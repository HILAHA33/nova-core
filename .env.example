# GEMINI_API_KEY: Optional secondary AI and image generation key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HUGGINGFACE_API_KEY: Primary neural inference and training key for Hugging Face models.
# Enter your Hugging Face User Access Token (hf_...) here or via AI Studio Secrets.
HUGGINGFACE_API_KEY=""

# HUGGINGFACE_MODEL: The smartest, fastest, and most credit-efficient model.
# Top recommended options:
# 1. "meta-llama/Llama-3.3-70B-Instruct" (Default - Frontier intelligence, free/lowest credits on HF)
# 2. "deepseek-ai/DeepSeek-R1-Distill-Qwen-32B" (Extreme reasoning power, ultra-efficient tokens)
# 3. "Qwen/Qwen2.5-Coder-32B-Instruct" (Top coding, engineering & math benchmarks)
# 4. "meta-llama/Meta-Llama-3.1-8B-Instruct" (Ultra-fast <300ms, minimal compute usage)
HUGGINGFACE_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# API_SECRET_KEY: Optional Bearer token for authenticating client API requests to /v1/*.
# Defaults to open or 'nova-sk-live-alpha' if unspecified.
API_SECRET_KEY="nova-sk-live-alpha"
