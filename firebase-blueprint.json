{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and multi-tenant identifier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastActiveAt": { "type": "number" }
      },
      "required": ["id", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Individual conversation thread for a specific user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "messageCount": { "type": "number" },
        "activeInstructionId": { "type": "string" }
      },
      "required": ["id", "userId", "createdAt", "updatedAt"]
    },
    "ChatMessageDoc": {
      "title": "ChatMessageDoc",
      "description": "A single message in a user's chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "model": { "type": "string" },
        "thoughtTrace": { "type": "string" }
      },
      "required": ["id", "chatId", "userId", "role", "content", "timestamp"]
    },
    "MultiStepInstruction": {
      "title": "MultiStepInstruction",
      "description": "Stateful multi-turn instruction or goal tracking across consecutive messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "chatId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "cancelled"] },
        "rawInstruction": { "type": "string" },
        "instructionType": { "type": "string" },
        "totalRequiredSteps": { "type": "number" },
        "currentStep": { "type": "number" },
        "capturedInputs": { "type": "array", "items": { "type": "string" } },
        "capturedNumbers": { "type": "array", "items": { "type": "number" } },
        "targetOperation": { "type": "string" },
        "stepHistory": { "type": "array" },
        "finalResult": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "chatId", "status", "rawInstruction", "createdAt"]
    },
    "LearnedFactUserInquiry": {
      "title": "LearnedFactUserInquiry",
      "description": "Knowledge distilled from what real users ask across all conversations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sourceUserId": { "type": "string" },
        "sourceChatId": { "type": "string" },
        "confidence": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "text", "category", "timestamp"]
    },
    "LearnedFactSelfLearning": {
      "title": "LearnedFactSelfLearning",
      "description": "Axioms and domain concepts distilled from autonomous recursive self-learning cycles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "cycleNumber": { "type": "number" },
        "domain": { "type": "string" },
        "confidence": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "text", "category", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "User",
      "/chats/{chatId}": {
        "entity": "ChatSession",
        "/messages/{messageId}": {
          "entity": "ChatMessageDoc"
        }
      },
      "/instructions/{instructionId}": {
        "entity": "MultiStepInstruction"
      }
    },
    "/learned_facts_user_inquiries/{factId}": {
      "entity": "LearnedFactUserInquiry"
    },
    "/learned_facts_self_learning/{factId}": {
      "entity": "LearnedFactSelfLearning"
    }
  }
}
